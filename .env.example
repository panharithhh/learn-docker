# LibraFlow environment. Copy it: `cp .env.example .env`, then change JWT_ACCESS_SECRET.
# Every value below is a safe placeholder: it runs everything locally and touches no shared
# database or paid service. Never commit .env (it is in .gitignore and .dockerignore).

# ---------------------------------------------------------------- Docker Compose
# Read by compose.yaml only, not by the app.
# Host name the api and seed containers use for Postgres: the compose service "db"
DB_HOST=db
# Ports on your machine. Postgres uses 5433 so it doesn't clash with one already on 5432.
API_PORT=3000
DB_HOST_PORT=5433
# API image: "local" = built from this checkout by `docker compose up -d --build`.
# A commit SHA runs that published image from ghcr.io instead (rollback, see README.md).
API_IMAGE_TAG=local

# ---------------------------------------------------------------- Database
# Used when the API runs on your machine (`npm run start:dev`); this points at the Compose db.
# Inside Compose the API connects to the "db" service instead. For a shared Supabase
# database, put its URL here and set DB_SSL=true.
DATABASE_URL=postgres://libraflow:libraflow@localhost:5433/libraflow_dev
DB_SSL=false

# ---------------------------------------------------------------- App
PORT=3000
# Leave unset: the Docker image runs as production and `npm run start:dev` works without it.
# Set development or test to print email codes to the console when SMTP is off.
# NODE_ENV=development

# Reserved for the Space Booking integration (x-api-key header). No code reads it yet.
SHARED_SERVICE_API_KEY=

# ---------------------------------------------------------------- Redis / BullMQ
# For the API on your machine. Inside Compose the API always uses the "redis" service.
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis key prefix for the queues; leave as is (the E2E tests use their own)
BULLMQ_PREFIX=bull

# ---------------------------------------------------------------- Overdue notifications
# Daily scan in LIBRARY_TIME_ZONE: marks late loan items overdue and queues one reminder per
# item. Cron format "min hour day month weekday"; "off" disables it
# (POST /api/v1/notifications/overdue/scan still works).
OVERDUE_SCAN_CRON="0 8 * * *"

# Queue dashboard at http://localhost:3000/queues (the browser asks for this login).
# Empty password = dashboard off (404). Use a strong password if you turn it on.
QUEUE_DASHBOARD_USER=admin
QUEUE_DASHBOARD_PASSWORD=

# ---------------------------------------------------------------- Email
# Empty SMTP_HOST = reminders are saved in-app and only logged; codes print to the console in
# development/test only, and registration cannot be verified in production.
# Example (Gmail app password): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-character app password>
SMTP_HOST=
SMTP_PORT=587
# true only for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LibraFlow <no-reply@libraflow.local>"

# ---------------------------------------------------------------- Telegram
# Reminders (due tomorrow, due today, overdue) on top of email. Create a bot with
# @BotFather and paste its token. Empty = Telegram off. The bot reads messages by polling:
# keep it on for exactly ONE running instance and set TELEGRAM_POLLING=off on the others.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING=on

# ---------------------------------------------------------------- Auth & users
# REQUIRED. The app refuses to start if this is missing, short, or looks like a placeholder.
# Generate one: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-generate-a-random-secret
# Optional; these are the defaults
FRONTEND_ORIGIN=http://localhost:5173
JWT_ACCESS_TTL=15m
REFRESH_IDLE_TTL=7d
REFRESH_ABSOLUTE_TTL_MEMBER=30d
REFRESH_ABSOLUTE_TTL_STAFF=12h
DEPOSIT_AMOUNT=5
GOLD_MEMBERSHIP_FEE=5
LIBRARY_TIME_ZONE=Asia/Phnom_Penh
# Limits member sign-up to these email domains (comma-separated, e.g. itc.edu.kh).
# Empty = anyone can join. Staff accounts are never restricted.
MEMBER_EMAIL_DOMAINS=

# ---------------------------------------------------------------- Seeds
# First admin on a real database: `npm run seed:admin`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
# Password for every account the dev seed creates (local databases only); this is the default
SEED_DEV_PASSWORD=libraflow-dev-password

# ---------------------------------------------------------------- Observability
# Traces, metrics and logs go to an OTLP/HTTP endpoint (e.g. Grafana Cloud).
# Empty endpoint = nothing is sent anywhere; logs still print to stdout. Example values:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
#   OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64 of instance-id:api-token>"
OTEL_SERVICE_NAME=libraflow-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# false = don't copy log lines to the console (the E2E tests do this)
LOG_STDOUT=true

# ---------------------------------------------------------------- Member assistant
# RAG over the catalog on the Gemini API. Free key: https://aistudio.google.com/apikey
# On the free tier Google may use prompts to improve its products: only use test data.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2
# Where catalog embeddings are cached between restarts; empty = no cache file
BOOK_EMBEDDINGS_CACHE=.cache/book-embeddings.json

# ---------------------------------------------------------------- Tests (npm run test:e2e)
# The Compose db creates libraflow_test on first start. Without these the tests use
# localhost:5432 and localhost:6379.
TEST_DATABASE_URL=postgres://libraflow:libraflow@localhost:5433/libraflow_test
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379
